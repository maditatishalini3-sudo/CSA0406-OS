#include <stdio.h>
int main()
{
    char user[2][20], file[2][20];
    int i;
    for(i = 0; i < 2; i++)
    {
        printf("Enter user name: ");
        scanf("%s", user[i]);
        printf("Enter file name: ");
        scanf("%s", file[i]);
    }
    printf("\nTwo-Level Directory:\n");
    for(i = 0; i < 2; i++)
        printf("%s -> %s\n", user[i], file[i]);
    return 0;
}
