#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
int main()
{
    int fd;
    struct stat s;
    DIR *d;
    struct dirent *file;
    fd = open("file.txt", O_CREAT | O_RDWR, 0644);

    if (fd == -1)
    {
        printf("File cannot be opened\n");
        return 0;
    }
    printf("File opened\n");

    fcntl(fd, F_GETFD);
    printf("fcntl() executed\n");

    lseek(fd, 0, SEEK_END);
    printf("lseek() executed\n");
    stat("file.txt", &s);
    printf("File size: %ld bytes\n", s.st_size);
    close(fd);
    d = opendir(".");
    if (d == NULL)
    {
        printf("Directory cannot be opened\n");
        return 0;
    }
    printf("\nDirectory files:\n");
    while ((file = readdir(d)) != NULL)
        printf("%s\n", file->d_name);
    closedir(d);
    return 0;
}
