#include <stdio.h>
int main() {
    int n, i, pos;
    printf("Enter number of records: ");
    scanf("%d", &n);
    printf("Enter records: ");
    int a[n];
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Enter record position to access: ");
    scanf("%d", &pos);
    printf("Records accessed: ");
    for(i = 0; i < pos; i++)
        printf("%d ", a[i]);
    return 0;
}
