#include <stdio.h>
#include <string.h>
int main()
{
    char text[100];
    char word[20];
    printf("Enter text: ");
    fgets(text, sizeof(text), stdin);
    printf("Enter word to search: ");
    scanf("%s", word);
    if (strstr(text, word) != NULL)
        printf("Word found\n");
    else
        printf("Word not found\n");
    return 0;
}
