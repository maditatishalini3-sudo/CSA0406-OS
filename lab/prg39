#include <stdio.h>
#include <stdlib.h>
int main() {
    int a[] = {82,170,43,140,24}, n=5;
    int head=50, size=200, i, j, t, total=0;
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
                t=a[i],a[i]=a[j],a[j]=t;
    for(i=0;i<n && a[i]<head;i++);
    for(j=i;j<n;j++)
        total+=abs(head-a[j]),head=a[j];
    total += size-1-head;
    head = size-1;
    total += size-1;
    head = 0;
    for(j=0;j<i;j++)
        total+=abs(head-a[j]),head=a[j];
    printf("Total Head Movement = %d", total);
    return 0;
}
