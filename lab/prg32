#include <stdio.h>
int main()
{
    int p[10] = {1, 2, 3, 1, 4};
    int f[3] = {-1, -1, -1};
    int recent[3] = {0, 0, 0};
    int i, j, pos, min, fault = 0;
    for (i = 0; i < 5; i++)
    {
        pos = -1;
        /* Check page */
        for (j = 0; j < 3; j++)
        {
            if (f[j] == p[i])
            {
                pos = j;
                break;
            }
        }
        /* Page fault */
        if (pos == -1)
        {
            fault++;
            /* Find empty frame */
            for (j = 0; j < 3; j++)
            {
                if (f[j] == -1)
                {
                    pos = j;
                    break;
                }
            }
            /* Find LRU page */
            if (pos == -1)
            {
                min = recent[0];
                pos = 0;

                for (j = 1; j < 3; j++)
                {
                    if (recent[j] < min)
                    {
                        min = recent[j];
                        pos = j;
                    }
                }
            }
            f[pos] = p[i];
        }
        recent[pos] = i + 1;
        printf("Page %d: ", p[i]);
        for (j = 0; j < 3; j++)
            printf("%d ", f[j]);
        printf("\n");
    }
    printf("Total Page Faults = %d\n", fault);
    return 0;
}
