#include <stdio.h>
int main()
{
    int p[10] = {1, 2, 3, 4, 2, 1, 5};
    int f[3] = {-1, -1, -1};
    int i, j, k, pos, far, next, fault = 0;
    int found;
    for (i = 0; i < 7; i++)
    {
        found = 0;
        /* Check if page is already present */
        for (j = 0; j < 3; j++)
        {
            if (f[j] == p[i])
            {
                found = 1;
                break;
            }
        }
        /* Page fault */
        if (found == 0)
        {
            fault++;
            pos = -1;
            far = -1;
            /* Find empty frame */
            for (j = 0; j < 3; j++)
            {
                if (f[j] == -1)
                {
                    pos = j;
                    break;
                }
            }
            /* Find page used farthest in future */
            if (pos == -1)
            {
                for (j = 0; j < 3; j++)
                {
                    next = 100;
                    for (k = i + 1; k < 7; k++)
                    {
                        if (f[j] == p[k])
                        {
                            next = k;
                            break;
                        }
                    }
                    if (next > far)
                    {
                        far = next;
                        pos = j;
                    }
                }
            }

            f[pos] = p[i];
        }
        printf("Page %d: ", p[i]);

        for (j = 0; j < 3; j++)
            printf("%d ", f[j]);
        printf("\n");
    }
    printf("\nTotal Page Faults = %d\n", fault);
    return 0;
}
