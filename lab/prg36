#include <stdio.h>
int main() {
    int n, block[20], next[20], i;
    printf("Enter number of blocks: ");
    scanf("%d", &n);
    printf("Enter block numbers: ");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);
    printf("Enter next block (-1 for last): ");
    for(i = 0; i < n; i++)
        scanf("%d", &next[i]);
    printf("\nLinked Allocation: ");
    for(i = 0; i < n; i++)
        printf("%d -> ", block[i]);
    printf("NULL");
    return 0;
}
