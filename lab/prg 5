#include<stdio.h>
int main()
{
    int p[3]={1,2,3}, pr[3]={2,1,3}, i, j, t;
    for(i=0;i<2;i++)
        for(j=i+1;j<3;j++)
            if(pr[i]>pr[j])
            {
                t=pr[i]; pr[i]=pr[j]; pr[j]=t;
                t=p[i]; p[i]=p[j]; p[j]=t;
            }
    for(i=0;i<3;i++)
        printf("P%d ",p[i]);
}
