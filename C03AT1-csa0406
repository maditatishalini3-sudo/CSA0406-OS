#include <stdio.h>
int main() {
float hitRatio, tlbTime, memTime, eat;
printf("Enter TLB Hit Ratio: ");
scanf("%f",&hitRatio);
printf("Enter TLB Access Time: ");
scanf("%f",&tlbTime);
printf("Enter Memory Access Time: ");
scanf("%f",&memTime);
eat = hitRatio*(tlbTime+memTime) +
(1-hitRatio)*(tlbTime+2*memTime);
printf("Effective Memory Access Time = %.2f ns\n", eat);
return 0;
}
OUTPUT:
Enter TLB Hit Ratio: 0.8
Enter TLB Access Time: 10
Enter Memory Access Time: 100
Effective Memory Access Time = 130.00 ns
