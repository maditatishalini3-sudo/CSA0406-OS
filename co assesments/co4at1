  4.import socket
server = socket.socket()
server.bind(("localhost", 5000))
server.listen(1)
print("Server waiting for connection...")
conn, addr = server.accept()
mac_table = {}
while True:
    data = conn.recv(1024).decode()
    if not data:
        break
    parts = data.split()
    host = parts[0]
    mac = parts[1]
    port = parts[2]
    mac_table[mac] = port
    print("\nFrame received from:", host)
    print("MAC Address:", mac)
    print("\nMAC Address Table")
    for m, p in mac_table.items():
        print(m, "->", p)
    conn.send("Frame received successfully".encode())
conn.close()
server.close()
