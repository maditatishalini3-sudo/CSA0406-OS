5.class StarSwitch:
    def __init__(self):
        self.ports = []
        self.log = []
    def add_port(self, host_id):
        self.ports.append(host_id)
        print(host_id, "connected")
    def remove_port(self, host_id):
        if host_id in self.ports:
            self.ports.remove(host_id)
            print(host_id, "disconnected")
    def broadcast(self, frame, source):
        print("\nBroadcasting frame:", frame)
        print("Source:", source)
        receivers = []
        for host in self.ports:
            if host != source:
                receivers.append(host)
                print("Frame received by:", host)
        self.log.append((source, receivers))
switch = StarSwitch()
switch.add_port("Host1")
switch.add_port("Host2")
switch.add_port("Host3")
switch.add_port("Host4")
switch.broadcast("Hello", "Host1")
switch.remove_port("Host4")
print("\nActive Ports:")
print(switch.ports)
print("\nBroadcast Log:")
for entry in switch.log:
    print("Source:", entry[0], "Receivers:", entry[1])
