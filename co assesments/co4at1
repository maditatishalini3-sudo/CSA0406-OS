3.import random
hosts = ["Host1", "Host2", "Host3", "Host4"]
log = open("csma_log.txt", "w")
for host in hosts:
    attempt = 1
    while True:
        log.write(host + " - Transmission attempt " + str(attempt) + "\n")
        collision = random.choice([True, False])
        if collision:
            backoff = random.randint(1, 5)
            print(host, "- Collision detected")
            print("Back-off time:", backoff)
            log.write("Collision detected\n")
            log.write("Back-off time: " + str(backoff) + "\n")
            attempt = attempt + 1
        else:
            print(host, "- Transmission successful")
            log.write("Transmission successful\n")
            break
log.close()
print("\nCSMA/CD simulation completed.")
print("Details are stored in csma_log.txt")
