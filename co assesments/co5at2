BEGIN
SET total_RAM = 16GB
SET host_reserved = 4GB
available_RAM = total_RAM - host_reserved
INPUT number_of_VMs
SET min_RAM = 2GB
FOR i = 1 TO number_of_VMs DO
IF available_RAM >= min_RAM THEN
ALLOCATE min_RAM TO VM[i]
available_RAM = available_RAM - min_RAM
 ELSE
 PRINT "Insufficient memory"
 ENDIF
  ENDFOR
PRINT "RAM allocation completed"
END
  
