BEGIN
SET threshold = 80%
usage = GET_DISK_USAGE()
IF usage > threshold THEN
IDENTIFY log_files
SORT log_files BY size DESCENDING
FOR each file IN log_files DO
DELETE or COMPRESS file
usage = GET_DISK_USAGE()
IF usage <= threshold THEN
BREAK
ENDIF
ENDFOR
ENDIF
PRINT "Disk space managed"
END 
  
